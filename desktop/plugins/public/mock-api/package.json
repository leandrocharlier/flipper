{
  "$schema": "https://fbflipper.com/schemas/plugin-package/v2.json",
  "name": "flipper-plugin-mock-api",
  "id": "MockAPI",
  "title": "Mock API",
  "description": "Local mock servers powered by the Mockoon engine, with TLS, rules, templates and proxying.",
  "version": "0.0.0",
  "pluginType": "device",
  "supportedDevices": [
    {"os": "Windows", "archived": false},
    {"os": "MacOS", "archived": false},
    {"os": "Linux", "archived": false}
