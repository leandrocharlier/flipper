{
  "name": "flipper-desktop",
  "productName": "Flipper",
  "version": "0.273.2",
  "description": "Flipper desktop application for Android debugging",
  "author": "Flipper contributors",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.17.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "electron test/smoke.cjs",
    "test:server": "node --test test/server-integration.cjs",
    "pack:win": "electron-builder --win dir --x64",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.leandrocharlier.flipper",
    "asar": true,
    "npmRebuild": false,
    "afterPack": "./verify-package.cjs",
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "main.cjs",
      "server-process.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/flipper-server-windows",
        "to": "server"
      },
      {
        "from": "../../dist/flipper-server-windows/node_modules",
        "to": "server/node_modules"
      }
    ],
    "win": {
      "icon": "../static/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Flipper-${version}-Windows-${arch}.${ext}"
  }
}
